post_install() {
	cat <<'MSG'
==> zenbook-duo-screenpad: finish the setup as your own user (not with sudo):
       zenbook-duo-screenpad-setup
    It asks before each step: the touchpad helper, the service, one line in
    ~/.config/hypr/hyprland.lua for the key bindings, and the shell plugin.
MSG
}

post_upgrade() {
	echo "==> zenbook-duo-screenpad: restart it with: systemctl --user restart zenbook-duo-screenpad.service"
	echo "    and: sudo systemctl restart zenbook-duo-screenpad-touchpad@\$(id -u).service"
}

pre_remove() {
	echo "==> zenbook-duo-screenpad: if you have not run 'zenbook-duo-screenpad-setup --remove',"
	echo "    remove the hyprland.lua line and the shell plugin yourself, and run"
	echo "    systemctl --user disable --now zenbook-duo-screenpad.service"
	echo "    sudo systemctl disable --now zenbook-duo-screenpad-touchpad@\$(id -u).service"
	echo "    omarchy-shell display-setups unhold \"desc:BOE 0x0921\" \"ScreenPad key\""
}
