post_install() {
	cat <<'MSG'
==> zenbook-duo-screenpad: three steps finish the setup, as your own user:

  1. Start the touchpad helper for your user:
       sudo systemctl enable --now zenbook-duo-screenpad-touchpad@$(id -u).service
  2. Start the service:
       systemctl --user enable --now zenbook-duo-screenpad.service
  3. Load the key bindings: add this line at the end of ~/.config/hypr/hyprland.lua
       local f = io.open("/usr/share/zenbook-duo-screenpad/zenbook-duo-screenpad.lua") if f then f:close() dofile("/usr/share/zenbook-duo-screenpad/zenbook-duo-screenpad.lua") end

  The touchpad surface is a shell plugin:
       omarchy plugin add https://github.com/gillmania/zenbook-duo-screenpad.git --enable
MSG
}

post_upgrade() {
	echo "==> zenbook-duo-screenpad: restart it with: systemctl --user restart zenbook-duo-screenpad.service"
	echo "    and: sudo systemctl restart zenbook-duo-screenpad-touchpad@\$(id -u).service"
}

pre_remove() {
	echo "==> zenbook-duo-screenpad: remove the hyprland.lua line, and run"
	echo "    omarchy-shell display-setups unhold \"desc:BOE 0x0921\" \"ScreenPad key\""
}
